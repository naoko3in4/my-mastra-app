<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>おすすめの旅行先</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
    }
    .container {
      max-width: 1000px;
      margin-top: 2rem;
    }
    .suggestion-card {
      border-radius: 15px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 1.5rem;
      transition: transform 0.2s;
    }
    .suggestion-card:hover {
      transform: translateY(-5px);
    }
    .weather-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    .score-badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 1.2rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1 class="text-center mb-4">おすすめの旅行先</h1>
    <div class="row">
      <% suggestions.forEach(suggestion => { %>
        <div class="col-md-6 mb-4">
          <div class="card suggestion-card">
            <div class="card-body">
              <span class="badge bg-primary score-badge">
                スコア: <%= Math.round(suggestion.score * 100) %>点
              </span>
              <h2 class="card-title"><%= suggestion.destinationJa %></h2>
              <p class="card-text"><%= suggestion.description %></p>
              
              <div class="row mb-3">
                <div class="col-md-6">
                  <h5>天気情報</h5>
                  <p>
                    気温: <%= suggestion.weather.temperature %>℃<br>
                    降水確率: <%= suggestion.weather.precipitation %>%<br>
                    天候: <%= suggestion.weather.condition %>
                  </p>
                </div>
                <div class="col-md-6">
                  <h5>フライト情報</h5>
                  <p>
                    価格: <%= suggestion.flight.price.amount.toLocaleString() %> <%= suggestion.flight.price.currency %><br>
                    所要時間: <%= suggestion.flight.duration %><br>
                    航空会社: <%= suggestion.flight.airline %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-primary">新しい検索を始める</a>
    </div>
  </div>
</body>
</html> 